# ─────────────────────────────────────────────────────────────────
# Profit Machines – Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# For LOCAL dev:  Copy to .env or .env.local
# For VERCEL:     Add these in Vercel Dashboard → Project Settings → Environment Variables
#                 (Select all environments: Production, Preview, Development)
# ─────────────────────────────────────────────────────────────────

# ── Sheet 1: Raw Data Collection & Webhook (Client-Side for Vite) ──
# Ingests live telemetry (95 columns) and form submissions directly from browser
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzWtOiEWIBxZnB6s0LAZbwqUnEcBxYcMlp2dFmQMwMBvwGJxKttxV59jT35Esdvph6QJw/exec

# ── Sheet 1: Raw Data Collection & Webhook (Server-Side for Vercel API) ──
# Used by Vercel serverless functions in api/_lib/google-sheets.ts
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzWtOiEWIBxZnB6s0LAZbwqUnEcBxYcMlp2dFmQMwMBvwGJxKttxV59jT35Esdvph6QJw/exec

# ── Sheet 2: Executive Analytics & Intelligence Processing Engine ──
# Used by /api/analytics to query the 16 processed analytical tabs
GOOGLE_ANALYTICS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx7R9VaqLbn0fv6E10n4t2ppOpQ46DpfxQv_xo0Eh29NbqWwveJNK1SkPvrrwzA1G9_pw/exec
VITE_GOOGLE_ANALYTICS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx7R9VaqLbn0fv6E10n4t2ppOpQ46DpfxQv_xo0Eh29NbqWwveJNK1SkPvrrwzA1G9_pw/exec

# ── Security: Analytics API Key (Shared secret) ──────────────────
ANALYTICS_API_KEY=profit-machines-secure-analytics-key-2026

# ── Redis Cloud Session Storage (Backend Server-Side Only) ────────
# Obtained from Redis Cloud Console (Databases → Configuration → Public endpoint & password)
# Note: Use TLS 'rediss://' protocol for encrypted cloud connection
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@redis-12345.c12.us-east-1-2.ec2.redns.redis-cloud.com:12345

# ── Cryptographic JWT Token Architecture (Backend Server-Side Only) 
# Minimum 32-character (256-bit) cryptographically strong random secret
JWT_SECRET=YOUR_32_PLUS_CHARACTER_CRYPTOGRAPHIC_JWT_SECRET_HERE
JWT_ISSUER=profitmachines-auth
JWT_AUDIENCE=profitmachines-client
JWT_ACCESS_TTL_SECONDS=900

# ── Google Sheets Session Logs Configuration (Traffic Analysis) ──
# Main Spreadsheet ID: 1KXcYogXkE3mlNTA-WMpBADlzXO6TAlJCeK4OaQiNlTY
TRAFFIC_ANALYSIS_SPREADSHEET_ID=1KXcYogXkE3mlNTA-WMpBADlzXO6TAlJCeK4OaQiNlTY
# Optional Service Account (if using direct Google Sheets API rather than Apps Script)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Email Service (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=ProfitMachines <onboarding@resend.dev>

# ── Team Notifications & Email Routing ──────────────────────────
TEAM_NOTIFICATION_EMAIL=asmitha.int2027g3@gmail.com
