# ─────────────────────────────────────────────────────────────────
# Profit Machines – Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# For LOCAL dev:  Copy to .env or .env.local
# For VERCEL:     Add these in Vercel Dashboard → Project Settings → Environment Variables
#                 (Select all environments: Production, Preview, Development)
# ─────────────────────────────────────────────────────────────────

# ── Sheet 1: Data Collection & Webhook (Client-Side for Vite) ────
# Ingests live telemetry (95 columns) and form submissions directly from browser
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxnpkQyIM_BYBc9mdR8SskAbzb74v8idiwUMbzLuqKlCGRExzNkwRLloL63KQ-uhRqCYA/exec

# ── Sheet 1: Data Collection & Webhook (Server-Side for Vercel API) ──
# Used by Vercel serverless functions in api/_lib/google-sheets.ts
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxnpkQyIM_BYBc9mdR8SskAbzb74v8idiwUMbzLuqKlCGRExzNkwRLloL63KQ-uhRqCYA/exec

# ── Sheet 2: Executive Analytics & Intelligence Processing Engine ──
# Used by /api/analytics to query the 16 processed analytical tabs
GOOGLE_ANALYTICS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbz1gK24YtOmFpuTspRub3iQ5YGEhyvW_S3SqEmIwUg-OmFRbu4WRstiLEaQtOB32U5y/exec
VITE_GOOGLE_ANALYTICS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbz1gK24YtOmFpuTspRub3iQ5YGEhyvW_S3SqEmIwUg-OmFRbu4WRstiLEaQtOB32U5y/exec

# ── Security: Analytics API Key (Optional shared secret) ────────
ANALYTICS_API_KEY=profit-machines-secure-analytics-key-2026

